# Customize error 404 page
Errordocument 404 /404/index.html

# http to https
RewriteEngine On
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://k8s-school.fr/$1 [R,L]

RewriteRule formations/(.*)$ /formations-kubernetes/$1 [R]
RewriteRule resources/blog/1-kubectl-run-deprecated/ /resources/en/blog/kubectl-run-deprecated/ [R]
RewriteRule resources/blog/kubectl-run-deprecated/ /resources/en/blog/kubectl-run-deprecated/ [R]
RewriteRule resources/blog/2-k8s-ci/ /resources/en/blog/k8s-ci/ [R]

# Unable to fix it in hugo-theme-learn
RewriteRule fr/resources/tags /resources/fr/tags [R]
RewriteRule en/resources/tags /resources/en/tags [R]
